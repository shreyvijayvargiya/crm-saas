rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Free CRM download leads (API / server writes — tighten if you add Admin SDK)
    match /free_crm_downloads/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // SaaS user + projects + nested CRM entity data
    // users/{userId}/projects/{crmType}/{entity}/{docId}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /projects/{crmType} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /{entity}/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
