		"icon": "LayoutDashboard",
		"accent": "zinc",
		"badge": "Default",
		"audience": ["agencies", "startups", "product teams"]
	},
	"homeRoute": "/dashboard",
	"chooserRoute": "/demo",
	"sidebar": [
