				{ "id": 43, "label": "Scheduler", "route": "/scheduler", "icon": "CalendarClock" },
				{ "id": 19, "label": "Email", "route": "/email", "icon": "Mail" },
				{ "id": 12, "label": "Projects", "route": "/projects", "icon": "FolderClosed" },
				{ "id": 34, "label": "Files", "route": "/files", "icon": "FolderOpen" },
