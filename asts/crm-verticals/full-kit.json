	"pages": [
		{
			"id": "dashboard",
			"label": "Dashboard",
			"route": "/dashboard",
			"templateId": "dashboard",
			"blocks": [
				{ "type": "stats", "items": ["leads", "conversion", "sales", "revenue"] },
				{ "type": "chart", "title": "Revenue trend" },
				{ "type": "table", "entity": "leads", "columns": ["name", "status", "owner", "value"] }
			]
		},
		{
			"id": "leads",
			"label": "Leads",
			"route": "/leads",
			"templateId": "leads",
			"blocks": [
				{ "type": "stats" },
				{ "type": "toolbar", "filters": ["Status", "Owner"] },
				{
					"type": "table",
					"entity": "leads",
					"columns": [
						{ "id": "name", "label": "Name", "type": "text" },
						{ "id": "company", "label": "Company", "type": "text" },
						{ "id": "status", "label": "Status", "type": "badge" },
						{ "id": "value", "label": "Value", "type": "currency" }
					]
				}
			]
		},
		{
			"id": "pipeline",
			"label": "Pipeline",
			"route": "/pipelines",
			"templateId": "pipeline",
			"blocks": [{ "type": "kanban", "entity": "deals" }]
		}
	],
	"entities": {
		"leads": {
			"singular": "Lead",
			"plural": "Leads",
			"fields": [
				{ "name": "name", "type": "text" },
				{ "name": "company", "type": "text" },
				{ "name": "status", "type": "status" },
				{ "name": "value", "type": "currency" }
			],
			"seedHint": "sales-crm"
		},
		"deals": {
			"singular": "Deal",
			"plural": "Deals",
			"fields": [
				{ "name": "name", "type": "text" },
				{ "name": "stage", "type": "status" },
				{ "name": "value", "type": "currency" }
			],
			"seedHint": "sales-crm"
		}
	},
	"notes": [
		"Full kit maps to existing handcrafted routes under app/.",
		"AI agents: prefer cloning indie-stripe or agency for thinner verticals."
	]
}
