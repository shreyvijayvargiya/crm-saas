{
	"version": 1,
	"kind": "saas-crm-vertical",
	"id": "digital-store",
	"meta": {
		"name": "Digital Store CRM",
		"tagline": "Sell ebooks, PDFs, icons & assets — products, invoices, payments",
		"description": "For online digital product sellers. Catalog ebooks, PDFs, icon packs and assets, manage buyers, issue invoices, track payments, and watch sales analytics in one admin.",
		"icon": "ShoppingBag",
		"accent": "rose",
		"badge": "Digital goods",
		"audience": ["digital sellers", "Gumroad-style founders", "asset marketplaces", "ebook authors"]
	},
	"homeRoute": "/products",
	"chooserRoute": "/demo",
	"sidebar": [
		{
			"id": "main",
			"label": "Overview",
			"items": [
				{ "id": 1, "label": "Dashboard", "route": "/dashboard", "icon": "Home" },
				{ "id": 16, "label": "Sales analytics", "route": "/analytics", "icon": "BarChart3", "keywords": ["revenue", "downloads"] }
			]
		},
		{
			"id": "catalog",
			"label": "Catalog",
			"items": [
				{
					"id": 23,
					"label": "Products",
					"route": "/products",
					"icon": "Package",
					"keywords": ["ebooks", "pdfs", "icons", "assets"]
				},
				{
					"id": 24,
					"label": "Storefront",
					"route": "/e-commerce",
					"icon": "ShoppingCart",
					"keywords": ["orders", "digital", "downloads"]
				},
				{
					"id": 242,
					"label": "Orders",
					"route": "/e-commerce/orders",
					"icon": "Package",
					"keywords": ["fulfillment", "purchases"]
				}
			]
		},
		{
			"id": "commerce",
			"label": "Commerce",
			"items": [
				{ "id": 8, "label": "Invoices", "route": "/invoices", "icon": "FileText" },
				{ "id": 11, "label": "Payments", "route": "/payments", "icon": "CreditCard" }
			]
		},
		{
			"id": "customers",
			"label": "Buyers",
			"items": [
				{ "id": 30, "label": "Users", "route": "/users", "icon": "UserCog", "keywords": ["buyers", "customers"] },
				{ "id": 4, "label": "Contacts", "route": "/contacts", "icon": "Contact" }
			]
		},
		{
			"id": "insights",
			"label": "Insights",
			"items": [
				{ "id": 25, "label": "Reports", "route": "/reports", "icon": "FileBarChart" },
				{ "id": 26, "label": "Activity", "route": "/activity", "icon": "Activity" }
			]
		},
		{
			"id": "system",
			"label": "System",
			"items": [
				{ "id": 14, "label": "Settings", "route": "/settings", "icon": "Settings" },
				{ "id": 20, "label": "Notifications", "route": "/notifications", "icon": "Bell" },
				{ "id": 33, "label": "Help", "route": "/help", "icon": "CircleHelp" }
			]
		}
	],
	"pages": [
		{
			"id": "products",
			"label": "Products",
			"route": "/products",
			"templateId": "products",
			"blocks": [
				{
					"type": "stats",
					"items": [
						{ "label": "Products live", "value": "86" },
						{ "label": "Ebooks", "value": "24" },
						{ "label": "Asset packs", "value": "41" },
						{ "label": "MRR / sales", "value": "$18.4k" }
					]
				},
				{ "type": "toolbar", "searchPlaceholder": "Search products…", "filters": ["Type", "Status"] },
				{
					"type": "table",
					"entity": "products",
					"columns": [
						{ "id": "name", "label": "Product", "type": "text" },
						{ "id": "type", "label": "Type", "type": "badge" },
						{ "id": "sku", "label": "SKU", "type": "text" },
						{ "id": "price", "label": "Price", "type": "currency" },
						{ "id": "sales", "label": "Sales", "type": "number" },
						{ "id": "status", "label": "Status", "type": "badge" }
					]
				}
			]
		},
		{
			"id": "orders",
			"label": "Orders",
			"route": "/e-commerce/orders",
			"templateId": "e-commerce",
			"blocks": [
				{ "type": "stats" },
				{
					"type": "table",
					"entity": "orders",
					"columns": [
						{ "id": "orderId", "label": "Order", "type": "text" },
						{ "id": "buyer", "label": "Buyer", "type": "text" },
						{ "id": "product", "label": "Product", "type": "text" },
						{ "id": "amount", "label": "Amount", "type": "currency" },
						{ "id": "status", "label": "Status", "type": "badge" }
					]
				}
			]
		},
		{
			"id": "invoices",
			"label": "Invoices",
			"route": "/invoices",
			"templateId": "invoices",
			"blocks": [
				{ "type": "stats" },
				{ "type": "toolbar" },
				{
					"type": "table",
					"entity": "invoices",
					"columns": [
						{ "id": "number", "label": "Number", "type": "text" },
						{ "id": "customer", "label": "Buyer", "type": "text" },
						{ "id": "amount", "label": "Amount", "type": "currency" },
						{ "id": "status", "label": "Status", "type": "badge" }
					]
				}
			]
		},
		{
			"id": "payments",
			"label": "Payments",
			"route": "/payments",
			"templateId": "payments",
			"blocks": [
				{ "type": "stats" },
				{
					"type": "table",
					"entity": "payments",
					"columns": [
						{ "id": "transactionId", "label": "Charge", "type": "text" },
						{ "id": "customer", "label": "Buyer", "type": "text" },
						{ "id": "amount", "label": "Amount", "type": "currency" },
						{ "id": "status", "label": "Status", "type": "badge" },
						{ "id": "date", "label": "Date", "type": "date" }
					]
				}
			]
		},
		{
			"id": "users",
			"label": "Users",
			"route": "/users",
			"templateId": "users",
			"blocks": [
				{ "type": "toolbar", "searchPlaceholder": "Search buyers…" },
				{
					"type": "table",
					"entity": "users",
					"columns": [
						{ "id": "name", "label": "Name", "type": "text" },
						{ "id": "email", "label": "Email", "type": "email" },
						{ "id": "purchases", "label": "Purchases", "type": "number" },
						{ "id": "spend", "label": "Spend", "type": "currency" },
						{ "id": "status", "label": "Status", "type": "badge" }
					]
				}
			]
		},
		{
			"id": "analytics",
			"label": "Sales analytics",
			"route": "/analytics",
			"templateId": "analytics",
			"blocks": [
				{
					"type": "stats",
					"items": [
						{ "label": "Gross sales", "value": "$42.1k" },
						{ "label": "Orders", "value": "1,204" },
						{ "label": "Refund rate", "value": "1.2%" },
						{ "label": "Top product", "value": "Icon Kit Pro" }
					]
				},
				{ "type": "chart", "title": "Digital sales trend" }
			]
		}
	],
	"entities": {
		"products": {
			"singular": "Product",
			"plural": "Products",
			"fields": [
				{ "name": "name", "type": "text" },
				{ "name": "type", "type": "status" },
				{ "name": "sku", "type": "text" },
				{ "name": "price", "type": "currency" },
				{ "name": "sales", "type": "number" },
				{ "name": "status", "type": "status" }
			],
			"seedHint": "digital-ebooks-pdfs-icons"
		},
		"orders": {
			"singular": "Order",
			"plural": "Orders",
			"fields": [
				{ "name": "orderId", "type": "text" },
				{ "name": "buyer", "type": "text" },
				{ "name": "product", "type": "text" },
				{ "name": "amount", "type": "currency" },
				{ "name": "status", "type": "status" }
			],
			"seedHint": "digital-orders"
		},
		"invoices": {
			"singular": "Invoice",
			"plural": "Invoices",
			"fields": [
				{ "name": "number", "type": "text" },
				{ "name": "customer", "type": "text" },
				{ "name": "amount", "type": "currency" },
				{ "name": "status", "type": "status" }
			],
			"seedHint": "digital-invoices"
		},
		"payments": {
			"singular": "Payment",
			"plural": "Payments",
			"fields": [
				{ "name": "transactionId", "type": "text" },
				{ "name": "customer", "type": "text" },
				{ "name": "amount", "type": "currency" },
				{ "name": "status", "type": "status" },
				{ "name": "date", "type": "date" }
			],
			"seedHint": "digital-payments"
		},
		"users": {
			"singular": "Buyer",
			"plural": "Buyers",
			"fields": [
				{ "name": "name", "type": "text" },
				{ "name": "email", "type": "email" },
				{ "name": "purchases", "type": "number" },
				{ "name": "spend", "type": "currency" },
				{ "name": "status", "type": "status" }
			],
			"seedHint": "digital-buyers"
		}
	},
	"notes": [
		"Product types in seed should include ebook, pdf, icon-pack, asset-pack.",
		"Reuses /products, /e-commerce, /invoices, /payments, /users, /analytics."
	]
}
