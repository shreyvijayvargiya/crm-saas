{
	"version": 1,
	"kind": "saas-crm-vertical",
	"id": "content-creator",
	"meta": {
		"name": "Creator CMS",
		"tagline": "Blogs, newsletters, subscribers, and content analytics",
		"description": "Built for content teams and creators. Write and publish blogs, send newsletters, manage subscribers/users, and track how posts perform — without a bloated sales CRM.",
		"icon": "PenLine",
		"accent": "amber",
		"badge": "Creators",
		"audience": ["content creators", "writers", "newsletter operators", "media teams"]
	},
	"homeRoute": "/cms",
	"chooserRoute": "/demo",
	"sidebar": [
		{
			"id": "main",
			"label": "Overview",
			"items": [
				{ "id": 1, "label": "Dashboard", "route": "/dashboard", "icon": "Home" },
				{ "id": 16, "label": "Content analytics", "route": "/analytics", "icon": "BarChart3", "keywords": ["views", "blogs", "seo"] }
			]
		},
		{
			"id": "publish",
			"label": "Publish",
			"items": [
				{
					"id": 13,
					"label": "CMS",
					"route": "/cms",
					"icon": "FileText",
					"keywords": ["blogs", "posts", "articles"],
					"children": [
						{ "id": 131, "label": "Blogs", "route": "/cms", "icon": "BookOpen" },
						{ "id": 132, "label": "Newsletters", "route": "/cms", "icon": "Send", "keywords": ["email", "subscribers"] }
					]
				},
				{ "id": 43, "label": "Scheduler", "route": "/scheduler", "icon": "CalendarClock", "keywords": ["social", "posts", "schedule"] },
				{ "id": 19, "label": "Inbox", "route": "/email", "icon": "Mail" }
			]
		},
		{
			"id": "audience",
			"label": "Audience",
			"items": [
				{ "id": 30, "label": "Users", "route": "/users", "icon": "UserCog", "keywords": ["subscribers", "readers"] },
				{ "id": 40, "label": "Marketing", "route": "/marketing", "icon": "Megaphone", "keywords": ["campaigns", "segments"] },
				{ "id": 4, "label": "Contacts", "route": "/contacts", "icon": "Contact" }
			]
		},
		{
			"id": "insights",
			"label": "Insights",
			"items": [
				{ "id": 25, "label": "Reports", "route": "/reports", "icon": "FileBarChart" },
				{ "id": 26, "label": "Activity", "route": "/activity", "icon": "Activity" }
			]
		},
		{
			"id": "system",
			"label": "System",
			"items": [
				{ "id": 14, "label": "Settings", "route": "/settings", "icon": "Settings" },
				{ "id": 20, "label": "Notifications", "route": "/notifications", "icon": "Bell" },
				{ "id": 33, "label": "Help", "route": "/help", "icon": "CircleHelp" }
			]
		}
	],
	"pages": [
		{
			"id": "cms",
			"label": "CMS",
			"route": "/cms",
			"templateId": "cms",
			"blocks": [
				{
					"type": "stats",
					"items": [
						{ "label": "Published posts", "value": "48" },
						{ "label": "Drafts", "value": "12" },
						{ "label": "Newsletters sent", "value": "9" },
						{ "label": "Subscribers", "value": "4.2k" }
					]
				},
				{ "type": "toolbar", "searchPlaceholder": "Search posts…", "filters": ["Status", "Author"] },
				{
					"type": "table",
					"entity": "blogs",
					"columns": [
						{ "id": "title", "label": "Title", "type": "text" },
						{ "id": "author", "label": "Author", "type": "text" },
						{ "id": "status", "label": "Status", "type": "badge" },
						{ "id": "views", "label": "Views", "type": "number" },
						{ "id": "publishedAt", "label": "Published", "type": "date" }
					]
				}
			]
		},
		{
			"id": "newsletters",
			"label": "Newsletters",
			"route": "/cms",
			"templateId": "cms",
			"blocks": [
				{ "type": "stats" },
				{
					"type": "table",
					"entity": "newsletters",
					"columns": [
						{ "id": "subject", "label": "Subject", "type": "text" },
						{ "id": "status", "label": "Status", "type": "badge" },
						{ "id": "opens", "label": "Opens", "type": "number" },
						{ "id": "sentAt", "label": "Sent", "type": "date" }
					]
				}
			]
		},
		{
			"id": "analytics",
			"label": "Content analytics",
			"route": "/analytics",
			"templateId": "analytics",
			"blocks": [
				{
					"type": "stats",
					"items": [
						{ "label": "Page views", "value": "128k" },
						{ "label": "Avg. time on post", "value": "3m 12s" },
						{ "label": "Newsletter CTR", "value": "4.8%" },
						{ "label": "New subscribers", "value": "+312" }
					]
				},
				{ "type": "chart", "title": "Blog traffic" },
				{
					"type": "table",
					"entity": "blogMetrics",
					"columns": [
						{ "id": "title", "label": "Post", "type": "text" },
						{ "id": "views", "label": "Views", "type": "number" },
						{ "id": "reads", "label": "Reads", "type": "number" },
						{ "id": "shares", "label": "Shares", "type": "number" }
					]
				}
			]
		},
		{
			"id": "users",
			"label": "Users",
			"route": "/users",
			"templateId": "users",
			"blocks": [
				{ "type": "toolbar", "searchPlaceholder": "Search users…" },
				{
					"type": "table",
					"entity": "users",
					"columns": [
						{ "id": "name", "label": "Name", "type": "text" },
						{ "id": "email", "label": "Email", "type": "email" },
						{ "id": "role", "label": "Role", "type": "badge" },
						{ "id": "status", "label": "Status", "type": "badge" }
					]
				}
			]
		}
	],
	"entities": {
		"blogs": {
			"singular": "Blog post",
			"plural": "Blogs",
			"fields": [
				{ "name": "title", "type": "text" },
				{ "name": "author", "type": "text" },
				{ "name": "status", "type": "status" },
				{ "name": "views", "type": "number" },
				{ "name": "publishedAt", "type": "date" }
			],
			"seedHint": "creator-blogs"
		},
		"newsletters": {
			"singular": "Newsletter",
			"plural": "Newsletters",
			"fields": [
				{ "name": "subject", "type": "text" },
				{ "name": "status", "type": "status" },
				{ "name": "opens", "type": "number" },
				{ "name": "sentAt", "type": "date" }
			],
			"seedHint": "creator-newsletters"
		},
		"users": {
			"singular": "User",
			"plural": "Users",
			"fields": [
				{ "name": "name", "type": "text" },
				{ "name": "email", "type": "email" },
				{ "name": "role", "type": "status" },
				{ "name": "status", "type": "status" }
			],
			"seedHint": "creator-subscribers"
		},
		"blogMetrics": {
			"singular": "Post metric",
			"plural": "Post metrics",
			"fields": [
				{ "name": "title", "type": "text" },
				{ "name": "views", "type": "number" },
				{ "name": "reads", "type": "number" },
				{ "name": "shares", "type": "number" }
			],
			"seedHint": "creator-analytics"
		}
	},
	"notes": [
		"Maps to existing /cms, /analytics, /users, /scheduler, /marketing routes.",
		"Newsletter deep-link can use /cms?section=newsletters when the CMS page supports it."
	]
}
