{
	"version": 1,
	"kind": "saas-crm-vertical",
	"id": "indie-stripe",
	"meta": {
		"name": "Indie Stripe Billing",
		"tagline": "Customers, charges, subscriptions — payment history on every contact",
		"description": "Stripe-shaped billing OS for indie hackers. MRR, failed charges, plans with price_ IDs, and CMS for launch notes. Built for the Product Hunt use case: stop tab-switching to Stripe.",
		"icon": "CreditCard",
		"accent": "violet",
		"badge": "PH favorite",
		"audience": ["indie hackers", "SaaS founders", "solopreneurs"]
	},
	"homeRoute": "/dashboard",
	"chooserRoute": "/demo",
	"sidebar": [
		{
			"id": "main",
			"label": "Revenue",
			"items": [
				{ "id": 1, "label": "Revenue", "route": "/dashboard", "icon": "DollarSign", "keywords": ["mrr", "stripe"] },
				{
					"id": 15,
					"label": "Failed charges",
					"route": "/payments",
					"icon": "AlertTriangle",
					"keywords": ["dunning", "past due", "retry", "stripe"]
				}
			]
		},
		{
			"id": "customers",
			"label": "Customers",
			"items": [
				{ "id": 4, "label": "Customers", "route": "/contacts", "icon": "Users", "keywords": ["cus_", "billing"] }
			]
		},
		{
			"id": "billing",
			"label": "Billing",
			"items": [
				{ "id": 11, "label": "Charges", "route": "/payments", "icon": "CreditCard" },
				{
					"id": 41,
					"label": "Subscriptions",
					"route": "/subscriptions",
					"icon": "Repeat",
					"children": [
						{ "id": 410, "label": "Overview", "route": "/subscriptions", "icon": "Repeat" },
						{ "id": 411, "label": "Plans", "route": "/subscriptions/plans", "icon": "Layers", "keywords": ["price_", "product"] }
					]
				}
			]
		},
		{
			"id": "content",
			"label": "Launch & reach",
			"items": [
				{
					"id": 13,
					"label": "Content",
					"route": "/cms",
					"icon": "Megaphone",
					"children": [
						{ "id": 131, "label": "Launch notes", "route": "/cms", "icon": "BookOpen" },
						{ "id": 132, "label": "Subscriber emails", "route": "/cms", "icon": "Send" },
						{ "id": 133, "label": "Inbox", "route": "/email", "icon": "Mail" }
					]
				}
			]
		},
		{
			"id": "system",
			"label": "Setup",
			"items": [
				{ "id": 14, "label": "Connect Stripe", "route": "/settings", "icon": "Cable", "keywords": ["api", "keys"] },
				{ "id": 20, "label": "Notifications", "route": "/notifications", "icon": "Bell" },
				{ "id": 33, "label": "Help", "route": "/help", "icon": "CircleHelp" }
			]
		}
	],
	"pages": [
		{
			"id": "revenue",
			"label": "Revenue",
			"route": "/dashboard",
			"templateId": "dashboard",
			"blocks": [
				{ "type": "connectBanner", "processor": "stripe" },
				{
					"type": "stats",
					"items": [
						{ "label": "MRR", "value": "$48.2k" },
						{ "label": "Active subs", "value": "312" },
						{ "label": "Past due", "value": "3" },
						{ "label": "Churn", "value": "2.1%" }
					]
				},
				{ "type": "chart", "title": "MRR trend" },
				{
					"type": "table",
					"entity": "failedCharges",
					"columns": [
						{ "id": "customer", "label": "Customer", "type": "text" },
						{ "id": "amount", "label": "Amount", "type": "currency" },
						{ "id": "status", "label": "Status", "type": "badge" },
						{ "id": "date", "label": "Date", "type": "date" }
					]
				}
			]
		},
		{
			"id": "customers",
			"label": "Customers",
			"route": "/contacts",
			"templateId": "contacts",
			"blocks": [
				{ "type": "toolbar", "searchPlaceholder": "Search customers…" },
				{
					"type": "table",
					"entity": "customers",
					"columns": [
						{ "id": "name", "label": "Name", "type": "text" },
						{ "id": "email", "label": "Email", "type": "email" },
						{ "id": "plan", "label": "Plan", "type": "text" },
						{ "id": "mrr", "label": "MRR", "type": "currency" },
						{ "id": "status", "label": "Status", "type": "badge" }
					]
				}
			]
		},
		{
			"id": "customer-detail",
			"label": "Customer profile",
			"route": "/contacts/[id]",
			"templateId": "contacts",
			"blocks": [
				{ "type": "recordTabs", "default": "billing", "items": ["billing", "activity", "notes"] },
				{ "type": "billingPanel", "processor": "stripe" }
			]
		},
		{
			"id": "plans",
			"label": "Plans",
			"route": "/subscriptions/plans",
			"templateId": "subscriptions",
			"blocks": [
				{
					"type": "table",
					"entity": "plans",
					"columns": [
						{ "id": "name", "label": "Plan", "type": "text" },
						{ "id": "stripePriceId", "label": "Price ID", "type": "text" },
						{ "id": "price", "label": "Price", "type": "currency" },
						{ "id": "interval", "label": "Interval", "type": "badge" },
						{ "id": "activeSubs", "label": "Active", "type": "number" }
					]
				}
			]
		}
	],
	"entities": {
		"customers": {
			"singular": "Customer",
			"plural": "Customers",
			"fields": [
				{ "name": "name", "type": "text" },
				{ "name": "email", "type": "email" },
				{ "name": "stripeCustomerId", "type": "text" },
				{ "name": "plan", "type": "text" },
				{ "name": "mrr", "type": "currency" },
				{ "name": "status", "type": "status" }
			],
			"seedHint": "indie-stripe-cast"
		},
		"plans": {
			"singular": "Plan",
			"plural": "Plans",
			"fields": [
				{ "name": "name", "type": "text" },
				{ "name": "stripePriceId", "type": "text" },
				{ "name": "price", "type": "currency" },
				{ "name": "billingInterval", "type": "status" }
			],
			"seedHint": "stripe-prices"
		},
		"failedCharges": {
			"singular": "Failed charge",
			"plural": "Failed charges",
			"fields": [
				{ "name": "customer", "type": "text" },
				{ "name": "amount", "type": "currency" },
				{ "name": "status", "type": "status" },
				{ "name": "transactionId", "type": "text" }
			],
			"seedHint": "stripe-charges-failed"
		}
	},
	"notes": [
		"UI is Stripe-shaped demo data — wire keys in production.",
		"Failed charges currently deep-links to /payments until a dedicated queue page is merged."
	]
}
