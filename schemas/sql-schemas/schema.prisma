// Reference relational model for pivoting this template to PostgreSQL.
// Not wired into the Next.js app by default — copy to `prisma/schema.prisma` or set `prisma.schema` in package.json.
//
// Validate: `DATABASE_URL=postgresql://localhost:5432/_ npx prisma@5 validate --schema=schemas/sql-schemas/schema.prisma`
// (Prisma 7+ moved datasource URLs; use Prisma 5–6 docs or migrate per https://pris.ly/d/config-datasource)
//
// Zod request/response shapes live in `schemas/*.js` (`schemas/index.js`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums (align with UI / data.json conventions) ---

enum DealStage {
  prospect
  qualified
  proposal
  won
  lost
}

enum InvoiceStatus {
  Paid
  Pending
  Overdue
}

enum PaymentStatus {
  Completed
  Pending
  Failed
}

enum TaskProgress {
  NotStarted
  InProgress
  Completed
}

enum TaskPriority {
  Low
  Medium
  High
}

enum TeamMemberStatus {
  Active
  Invited
  Inactive
}

enum BlogPostStatus {
  Published
  Draft
}

enum ApiKeyStatus {
  Active
  Revoked
}

enum WebhookStatus {
  Active
  Inactive
}

enum ActivityType {
  note
  email
  deal
  call
}

enum NotificationCategory {
  Ticket
  Team
  Message
}

// --- Core identity ---

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  role      String? // display role e.g. Sales Manager
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCompanies Company[]       @relation("CompanyOwner")
  ownedContacts  Contact[]       @relation("ContactOwner")
  ownedLeads     Lead[]          @relation("LeadOwner")
  repDeals       Deal[]          @relation("DealRep")
  assignments    TaskAssignee[]
  notifications  Notification[]
}

// --- CRM accounts ---

model Company {
  id        String    @id @default(cuid())
  name      String
  industry  String?
  rating    Decimal?  @db.Decimal(3, 1)
  location  String?
  logoUrl   String?
  ownerId   String?
  owner     User?     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contacts Contact[]
  leads    Lead[]
  deals    Deal[]

  @@index([ownerId])
  @@map("companies")
}

model Contact {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name        String
  email       String
  phone       String?
  title       String?
  lifecycle   String? // Prospect | Customer | …
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities Activity[]
  notes      ContactNote[]
  emails     EmbeddedEmailStub[] @relation("ContactEmails")
  files      RecordFile[]

  @@index([companyId])
  @@index([email])
  @@map("contacts")
}

model Pipeline {
  id        String           @id @default(cuid())
  name      String           @default("Default")
  createdAt DateTime         @default(now())
  stages    PipelineStage[]
}

model PipelineStage {
  id         String    @id @default(cuid())
  pipelineId String
  pipeline   Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  slug       String // e.g. new, contacted — stable id from UI Kanban columns
  label      String // e.g. Backlog
  sortOrder  Int       @default(0)
  leads      Lead[]

  @@unique([pipelineId, slug])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

model Lead {
  id               String           @id @default(cuid())
  companyId        String?
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId          String?
  owner            User?            @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  pipelineStageId  String?
  pipelineStage    PipelineStage?   @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  name             String
  email            String
  phone            String?
  title            String?
  source           String?
  status           String?
  estimatedValue   Decimal?         @db.Decimal(14, 2)
  imageUrl         String?
  lastContactedAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  activities Activity[]
  notes      LeadNote[]
  deals      Deal[]     @relation("LeadDeals")
  files      RecordFile[]

  @@index([companyId])
  @@index([pipelineStageId])
  @@index([email])
  @@map("leads")
}

model Deal {
  id           String      @id @default(cuid())
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leadId       String?
  lead         Lead?       @relation("LeadDeals", fields: [leadId], references: [id], onDelete: SetNull)
  repId        String?
  rep          User?       @relation("DealRep", fields: [repId], references: [id], onDelete: SetNull)
  name         String
  value        Decimal     @db.Decimal(14, 2)
  stage        DealStage
  closeDate    DateTime?
  priority     String?
  tag          String?
  lastActivity String? // UI short label e.g. "Apr 14 · Call logged"
  daysInStage  Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId])
  @@index([stage])
  @@index([leadId])
  @@map("deals")
}

// --- Tasks ---

model Task {
  id              String           @id @default(cuid())
  sectionSlug     String // backlog | in-progress | completed column id
  sectionLabel    String?
  title           String
  description     String?
  progress        TaskProgress?
  priority        TaskPriority?
  progressPercent Int              @default(0)
  icon            String?
  attachments     Int              @default(0)
  commentsCount   Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assignees TaskAssignee[]
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignees")
}

// --- Finance ---

model Invoice {
  id            String           @id @default(cuid())
  invoiceNumber String           @unique
  clientLabel   String
  clientEmail   String?
  clientId      String? // optional FK to Company when normalized
  amount        Decimal          @db.Decimal(14, 2)
  status        InvoiceStatus
  issueDate     DateTime
  dueDate       DateTime
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items    InvoiceLineItem[]
  payments Payment[]

  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id              String           @id @default(cuid())
  transactionId   String           @unique
  invoiceId       String?
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount          Decimal          @db.Decimal(14, 2)
  currency        String           @default("USD")
  status          PaymentStatus
  paymentMethod   String
  customerLabel   String
  customerEmail   String
  description     String?
  fee             Decimal?         @db.Decimal(14, 2)
  netAmount       Decimal?         @db.Decimal(14, 2)
  occurredAt      DateTime
  occurredTime    String? // display-only "10:30 AM"
  createdAt       DateTime         @default(now())

  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

// --- Ops / misc ---

model Project {
  id                String    @id @default(cuid())
  projectName       String
  clientName        String
  clientAvatarColor String?
  startDate         DateTime?
  deadline          DateTime?
  status            String?
  progress          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("projects")
}

model CalendarEvent {
  id         String    @id @default(cuid())
  title      String
  timeLabel  String? // "10am"
  color      String?
  startsAt   DateTime?
  dayOfMonth Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("calendar_events")
}

model EmailThread {
  id           String           @id @default(cuid())
  subject      String
  preview      String?
  fromName     String
  fromEmail    String
  lastTime     String?
  unread       Boolean          @default(true)
  starred      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  messages EmailMessage[]
}

model EmailMessage {
  id         String      @id @default(cuid())
  threadId   String
  thread     EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromName   String
  fromEmail  String
  toAddress  String?
  sentAtLabel String?
  body       String
  createdAt  DateTime    @default(now())

  @@index([threadId])
  @@map("email_messages")
}

model Notification {
  id        String                 @id @default(cuid())
  userId    String?
  user      User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  category  NotificationCategory
  timeLabel String?
  unread    Boolean               @default(true)
  avatarUrl String?
  hasActions Boolean              @default(false)
  createdAt DateTime              @default(now())

  @@index([userId])
  @@map("notifications")
}

// --- Developer / integrations ---

model Integration {
  id           String    @id @default(cuid())
  name         String    @unique
  enabled      Boolean   @default(false)
  tag          String?
  lastUpdated  DateTime?
  createdAt    DateTime  @default(now())

  @@map("integrations")
}

model ApiKey {
  id        String       @id @default(cuid())
  name      String
  /// Store hashed secret in production — never persist raw keys
  keyHash   String?
  status    ApiKeyStatus @default(Active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@map("api_keys")
}

model Webhook {
  id         String              @id @default(cuid())
  name       String
  url        String
  events     Json // string[] serialized
  /// Store signing secret hashed in production
  secretHash String?
  status     WebhookStatus       @default(Active)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("webhooks")
}

// --- Team roster (Teams page; connect to User in your app layer if needed)

model TeamMemberProfile {
  id       String           @id @default(cuid())
  name     String
  email    String           @unique
  role     String
  status   TeamMemberStatus @default(Active)
  joinedAt DateTime?
  imageUrl String?

  @@map("team_members")
}

// --- CMS ---

model BlogPost {
  id           String           @id @default(cuid())
  title        String
  authorName   String
  authorAvatar String?
  category     String?
  status       BlogPostStatus   @default(Draft)
  publishDate  DateTime?
  views        Int              @default(0)
  likes        Int              @default(0)
  content      String           @db.Text
  tags         String[] // PostgreSQL text[]
  featuredImage String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@map("blog_posts")
}

model BlogSubscriber {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  subscribedDate  DateTime?
  status          String?
  avatarColor     String?

  @@map("blog_subscribers")
}

// --- Polymorphic-style activity / notes on record detail pages ---

model Activity {
  id         String           @id @default(cuid())
  type       ActivityType
  title      String
  body       String           @db.Text
  occurredAt DateTime?
  actorLabel String? // "System" | user display
  createdAt  DateTime         @default(now())

  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([contactId])
  @@map("activities")
}

model LeadNote {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body       String    @db.Text
  authoredAt DateTime?
  author     String?

  @@index([leadId])
  @@map("lead_notes")
}

model ContactNote {
  id         String    @id @default(cuid())
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  body       String    @db.Text
  authoredAt DateTime?
  author     String?

  @@index([contactId])
  @@map("contact_notes")
}

model RecordFile {
  id         String    @id @default(cuid())
  name       String
  sizeLabel  String?
  mimeFamily String?
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([contactId])
  @@map("record_files")
}

/// Denormalised email stubs shown on Contacts list rows
model EmbeddedEmailStub {
  id        String    @id @default(cuid())
  contactId String
  contact   Contact   @relation("ContactEmails", fields: [contactId], references: [id], onDelete: Cascade)
  subject   String?
  body      String?   @db.Text
  sentAt    DateTime?

  @@index([contactId])
  @@map("contact_embedded_emails")
}

enum EcommerceProductCategory {
  Smartphone
  Laptop
  Headphone
  Smartwatch
}

enum EcommerceProductStatus {
  Publish
  Inactive
}

enum EcommerceOrderTab {
  New
  Pending
  Shipping
}

model EcommerceProduct {
  id            String                   @id @default(cuid())
  name          String
  brand         String
  imageUrl      String?                  @map("image_url")
  category      EcommerceProductCategory
  inStock       Boolean                  @default(true) @map("in_stock")
  price         Decimal                  @db.Decimal(12, 2)
  quantity      Int                      @default(0)
  status        EcommerceProductStatus   @default(Publish)
  description   String?                  @db.Text
  sku           String?
  visitorsLabel String?                  @map("visitors_label")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  orders        EcommerceOrder[]

  @@index([category])
  @@map("ecommerce_products")
}

model EcommerceOrder {
  id              String            @id @default(cuid())
  productId       String            @map("product_id")
  product         EcommerceProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tab             EcommerceOrderTab @default(New)
  senderName      String            @map("sender_name")
  senderAddress   String            @map("sender_address")
  receiverName    String            @map("receiver_name")
  receiverAddress String            @map("receiver_address")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([productId])
  @@map("ecommerce_orders")
}
