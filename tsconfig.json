{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"allowJs": true,
		"checkJs": false,
		"skipLibCheck": true,
		"strict": false,
		"noEmit": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": ["src", "app", "components", "modules", "lib", "utils", "schemas"],
	"exclude": ["node_modules", ".output", ".next"]
}
